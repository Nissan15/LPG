# Smart LPG Monitor - Environment Configuration

# --- Supabase Database Configuration ---
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase Public Anonymous API Key (Project Settings -> API -> Project API keys -> anon/public)
VITE_SUPABASE_ANON_KEY=

# --- ESP32 Hardware Configuration ---
# Default ESP32 REST API endpoint for load cell readings
VITE_ESP32_API_URL=http://192.168.1.180/api/weight

# Optional fallback polling interval in seconds
VITE_ESP32_POLL_INTERVAL=30
